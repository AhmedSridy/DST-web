# GEMINI_API_KEY: Required server-side secret for Gemini AI OCR endpoints.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional fallback Gemini API keys for automatic transparent failover on 429 quota limits.
# Completely optional: when omitted, only GEMINI_API_KEY is used.
# You can supply a comma/newline-separated list in GEMINI_API_KEYS and/or GEMINI_API_KEY_2..GEMINI_API_KEY_10.
# GEMINI_API_KEYS=""
# GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""

# GEMINI_OCR_MODEL (Optional): Override for the Gemini vision/OCR model name.
# When unset, defaults to "gemini-4-hydrogen" with high thinking level for OCR accuracy.
# GEMINI_OCR_MODEL="gemini-4-hydrogen"

# CENTRAL_API_TOKEN (Optional): Server-only Bearer token sent as Authorization header
# on POST /api/central/sync requests. If omitted, requests are sent without a Bearer
# token and the app continues running normally. Never logged or exposed to the client.
# CENTRAL_API_TOKEN=""

# VITE_RECAPTCHA_SITE_KEY (Optional): Google reCAPTCHA v3 site key for Firebase App Check.
# When unset, App Check initialization is safely skipped.
VITE_RECAPTCHA_SITE_KEY=""

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# Optional SMTP settings (admin-only server-side stock alert email dispatch).
# Completely optional: when omitted, automatic email dispatch is silently disabled
# and the app runs and deploys normally without requiring any SMTP variable.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
